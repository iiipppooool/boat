# ---------------------------------------------------------------------------
# BoatXchange environment configuration
# Copy to `.env.local` and fill in. Never commit the filled-in file.
# ---------------------------------------------------------------------------

# --- AI Concierge -----------------------------------------------------------
# The concierge is deliberately provider-agnostic: every model call goes through
# the single adapter in src/lib/ai/provider.ts. To swap providers, add an adapter
# there and change CONCIERGE_PROVIDER — no UI or page code changes required.

# Which adapter to use: "anthropic" (default) or "echo" (no network, dev/demo).
CONCIERGE_PROVIDER=anthropic

# Model id for the chosen provider. Default is Claude Haiku 4.5 — the cheapest
# current Claude model ($1 / $5 per million input / output tokens). See README
# for why a small model is the right call for this workload.
CONCIERGE_MODEL=claude-haiku-4-5

# API key for the chosen provider.
ANTHROPIC_API_KEY=

# --- Data -------------------------------------------------------------------
# Where the SQLite inventory lives. Defaults to ./var/boatxchange.db.
# Point this at a mounted volume in production (Fly/Railway/Render) so listings
# survive redeploys, or swap the adapter in src/lib/db.ts for hosted Postgres.
DATABASE_PATH=./var/boatxchange.db

# --- Billing (Stripe) -------------------------------------------------------
# Without these, billing is disabled: the account page says so and the API
# refuses cleanly rather than erroring. Nothing else stops working.

# Secret key from https://dashboard.stripe.com/apikeys (sk_test_… to start).
STRIPE_SECRET_KEY=

# The recurring Price for the Boathouse tier. Create a Product with a recurring
# price in the Stripe dashboard and paste its price_… id here.
STRIPE_BOATHOUSE_PRICE_ID=

# Signing secret for the webhook endpoint (whsec_…). Locally:
#   stripe listen --forward-to localhost:3000/api/billing/webhook
# In production, from the endpoint you create in the Stripe dashboard.
STRIPE_WEBHOOK_SECRET=

# Public origin, used for Stripe success/cancel/return URLs and page metadata.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Email (waiting list, confirmations) ------------------------------------
# All outbound mail goes through the single adapter in src/lib/email/provider.ts.
# With nothing set here, messages are written to the server log instead of being
# sent: signups still succeed and are still stored, they just are not confirmed
# by email. Nothing else stops working.

# Which adapter to use: "resend" or "log" (default when RESEND_API_KEY is unset).
EMAIL_PROVIDER=log

# API key from https://resend.com/api-keys.
RESEND_API_KEY=

# The From address. Must be on a domain you have verified with the provider.
EMAIL_FROM="BoatXchange <hello@yourdomain.com>"

# Where a copy of every waiting-list signup is sent. Blank disables the copy.
EMAIL_NOTIFY_TO=
